PORT=5000
NODE_ENV=development

# Atlas, or a local replica set (billing uses transactions, a standalone mongod won't work)
MONGO_URI=mongodb://127.0.0.1:27017/servekaro?replicaSet=rs0

# openssl rand -hex 32   (two different values)
JWT_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGIN=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Optional in dev. Without it image upload returns 503.
CLOUDINARY_URL=

# Optional in dev. Without it emails (OTP, invites) are printed to the console.
SMTP_URL=
MAIL_FROM="ServeKaro <no-reply@servekaro.com>"
